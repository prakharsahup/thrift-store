NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=              # server only
RAZORPAY_WEBHOOK_SECRET=          # server only
RESEND_API_KEY=                   # server only
EMAIL_FROM=
SUPPORT_INBOX=                    # server only; where contact-form messages are forwarded (defaults to the customer-care email in lib/config/legal.ts)
ORDER_NOTIFICATION_EMAIL=         # server only; where new-order alerts go (defaults to the customer-care email in lib/config/legal.ts)
SENTRY_DSN=                        # server + edge runtime (instrumentation.ts); both DSNs are the same value, just two env vars because only NEXT_PUBLIC_* reaches the browser bundle
NEXT_PUBLIC_SENTRY_DSN=            # browser runtime (instrumentation-client.ts)
SENTRY_ORG=                        # optional; only needed to upload source maps on build
SENTRY_PROJECT=                    # optional; only needed to upload source maps on build
SENTRY_AUTH_TOKEN=                 # optional, server only; only needed to upload source maps on build
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false  # true once Google OAuth is configured in Supabase
NEXT_PUBLIC_AUTH_PHONE_ENABLED=false   # true once an SMS provider is configured in the Supabase dashboard
